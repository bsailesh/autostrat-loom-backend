# Copy this file to .env and fill in your values. Never commit the real .env file.

# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by all agents. Override per-agent in config.py if you want to mix models.
LOOM_MODEL=claude-sonnet-5

# SQLite file path. Fine for local dev / demo. Swap for a Postgres URL later
# (DATABASE_URL=postgresql://user:pass@host:5432/loom) with zero code changes
# elsewhere, because all DB access goes through database.py.
DATABASE_URL=sqlite:///./loom.db

# Comma-separated list of admin API keys allowed to create new tenants.
# In production this becomes a real onboarding flow, not a static list.
LOOM_ADMIN_KEYS=admin-dev-key-change-me
