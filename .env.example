# Copy this file to .env and fill in your values. Never commit the real .env file.

# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by all agents. Override per-agent in config.py if you want to mix models.
LOOM_MODEL=claude-sonnet-5

# SQLite file path. Fine for local dev / demo. Swap for a Postgres URL later
# (DATABASE_URL=postgresql://user:pass@host:5432/loom) with zero code changes
# elsewhere, because all DB access goes through database.py.
DATABASE_URL=sqlite:///./loom.db

# Comma-separated list of admin API keys allowed to create new tenants.
# In production this becomes a real onboarding flow, not a static list.
LOOM_ADMIN_KEYS=admin-dev-key-change-me

# How long a login session token (from POST /auth/login) stays valid.
SESSION_TTL_HOURS=24

# --- Contact form email ---
# Where "Request a trial" / contact form submissions get emailed.
CONTACT_EMAIL_TO=saileshathreya@autostrat.net

# SMTP credentials used to actually send that email. If SMTP_HOST is left
# blank, submissions are still saved to the database, but no email is sent
# (a warning is logged instead) — useful for local dev without real
# credentials. For AWS SES: host is your region's SES SMTP endpoint (e.g.
# email-smtp.us-east-1.amazonaws.com), port 587, user/password are SES SMTP
# credentials (not your AWS access key), and smtp_from must be a
# domain/address verified in SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@autostrat.net
SMTP_USE_TLS=true

# Comma-separated origins allowed to call this API from a browser.
# "*" is fine for local development. Restrict this before deploying —
# e.g. for autostrat.net:
# CORS_ORIGINS=https://autostrat.net,https://www.autostrat.net
CORS_ORIGINS=*
